                <mxCell id="sec-e-mobile-kc-lbl" value="PKCE Auth Code Flow&#xa;(токены в Secure Storage устройства)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#4D8C82;fontStyle=1;" parent="sec-e-mobile-kc" connectable="0" vertex="1">
