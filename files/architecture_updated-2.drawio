                <object placeholders="1" c4Name="External IdP" c4Type="Software System" c4Technology="LDAP / OIDC / SAML" c4Description="Удостоверяющая служба в стране представительства. Хранит учётные данные пользователей локально. Персональные и медицинские данные не передаются в BionicPRO." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#cccccc&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="sec-ext-idp">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#AE4132;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#8B2E22;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1">
                        <mxGeometry x="-70" y="1190" width="260" height="130" as="geometry"/>
                    </mxCell>
                </object>
                <object placeholders="1" c4Name="Веб-фронтенд (Отчёты)" c4Type="Container" c4Technology="React SPA" c4Description="Позволяет пилоту протеза скачать отчёт о работе протеза. НЕ получает токены от IdP — общается с BFF через HTTP-only сессионную куку." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="sec-web-frontend">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1">
                        <mxGeometry x="390" y="750" width="240" height="130" as="geometry"/>
                    </mxCell>
                </object>
                <object placeholders="1" c4Name="BFF (Backend for Frontend)" c4Type="Container" c4Technology="Node.js / Spring Boot" c4Description="НОВЫЙ. Принимает запросы от веб-фронтенда по HTTP-only сессионной куке. Выполняет PKCE Code Flow с Keycloak от имени пользователя. Хранит access- и refresh-токены на сервере — фронтенд токены не видит." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="sec-bff">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#67AB9F;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#4D8C82;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1">
                        <mxGeometry x="380" y="970" width="260" height="140" as="geometry"/>
                    </mxCell>
                </object>
                <object placeholders="1" c4Name="Keycloak (IdP Broker)" c4Type="Container" c4Technology="Keycloak 21" c4Description="НОВЫЙ. Центральная IAM-платформа. Брокирует аутентификацию во внешние IdP (LDAP / OIDC / SAML). Выдаёт access- и refresh-токены. Авторизационные данные хранятся локально." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="sec-keycloak">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#67AB9F;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#4D8C82;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1">
                        <mxGeometry x="620" y="1240" width="260" height="140" as="geometry"/>
                    </mxCell>
                </object>
                <object placeholders="1" c4Name="Keycloak DB" c4Type="Container" c4Technology="PostgreSQL" c4Description="НОВЫЙ. Хранит только авторизационные данные: сессии, роли, маппинги федерации. Персональные и медицинские данные пациентов НЕ хранятся." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%:&amp;nbsp;%c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="sec-keycloak-db">
                    <mxCell style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#67AB9F;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#4D8C82;metaEdit=1;resizable=0;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1">
                        <mxGeometry x="1050" y="1250" width="240" height="120" as="geometry"/>
                    </mxCell>
                </object>
                <mxCell id="sec-e-pilot-web" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" source="Lhtp9tOnbV0N8Cz71-gY-2" target="sec-web-frontend" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
