                <mxCell id="sec-e-pilot-web-lbl" value="Просматривает отчёты" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="sec-e-pilot-web" connectable="0" vertex="1">
                    <mxGeometry x="0.1" y="-10" relative="1" as="geometry">
