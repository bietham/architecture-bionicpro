                <mxCell id="sec-e-bff-kc-lbl" value="PKCE Authorization Code Flow&#xa;(access+refresh токены хранятся в BFF, не у клиента)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#4D8C82;fontStyle=1;" parent="sec-e-bff-kc" connectable="0" vertex="1">
