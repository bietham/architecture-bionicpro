                <object placeholders="1" c4Name="Airflow DAG: etl_crm_to_olap" c4Type="Container" c4Technology="Apache Airflow 2.9" c4Description="Ежедневно 02:00 UTC: извлекает клиентов из CRM DB, агрегирует телеметрию из OLAP DB, объединяет и записывает в витрину report_mart." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="etl-airflow">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#D79B00;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#B46504;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1">
                        <mxGeometry x="1810" y="180" width="280" height="160" as="geometry"/>
