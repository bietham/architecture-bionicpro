                <mxCell id="sec-e-web-bff" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4D8C82;strokeWidth=2;" parent="1" source="sec-web-frontend" target="sec-bff" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
