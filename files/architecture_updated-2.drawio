                <mxCell id="sec-e-web-bff-lbl" value="HTTP-only сессионная кука&#xa;(токены IdP фронтенду не передаются)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#4D8C82;fontStyle=1;" parent="sec-e-web-bff" connectable="0" vertex="1">
