                <mxCell id="sec-e-kc-db-lbl" value="Сессии, роли,&#xa;маппинги федерации" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="sec-e-kc-db" connectable="0" vertex="1">
