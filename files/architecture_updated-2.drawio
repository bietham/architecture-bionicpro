                <object placeholders="1" c4Name="ETL Pipeline" c4Type="SystemScopeBoundary" c4Application="Apache Airflow" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;&lt;div style=&quot;text-align: left&quot;&gt;%c4Name%&lt;/div&gt;&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left&quot;&gt;[%c4Application%]&lt;/div&gt;" id="etl-boundary">
